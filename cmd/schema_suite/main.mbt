///|
fn digest(bytes : Bytes) -> String {
  let hex = "0123456789abcdef".to_array()
  let out = StringBuilder()
  for byte in @crypto.sha256_from_iter(bytes.iter()) {
    let value = byte.to_int()
    out.write_char(hex[value >> 4])
    out.write_char(hex[value & 15])
  }
  out.to_string()
}

///|
async fn read_json(path : String) -> (@pjson.Json, String) {
  let bytes = @fs.read_file(path).binary()
  (parse_json(@utf8.decode(bytes)), digest(bytes))
}

///|
async fn inventory(
  directory : String,
  relative : String,
  files : Array[String],
) -> Unit {
  let dir = @fs.opendir(directory)
  defer dir.close()
  while dir.next() is Some(entry) {
    let path = if relative == "" {
      entry.name
    } else {
      relative + "/" + entry.name
    }
    if entry.is_dir {
      inventory(directory + "/" + entry.name, path, files)
    } else {
      files.push(path)
    }
  }
}

///|
async fn load_suite(errors : Array[String]) -> Map[String, @pjson.Json] {
  let base = "testdata/json-schema-suite"
  let (upstream, _) = read_json(base + "/UPSTREAM.json")
  if string(field(upstream, "commit")) != upstream_sha ||
    string(field(upstream, "repository")) !=
    "https://github.com/json-schema-org/JSON-Schema-Test-Suite" {
    raise RunnerError("upstream source does not match the fixed version")
  }
  let scope = array(field(upstream, "scope")).map(string)
  if scope != ["LICENSE", "tests/draft2020-12/**"] {
    raise RunnerError("unexpected upstream directory scope")
  }
  if string(field(upstream, "update")) == "" {
    raise RunnerError("upstream update instructions are missing")
  }
  let expected : Map[String, String] = Map([])
  for entry in array(field(upstream, "files")) {
    let file = string(field(entry, "path"))
    if !safe_file(file) ||
      (file != "LICENSE" && !file.has_prefix("tests/draft2020-12/")) {
      raise RunnerError("unsafe or out-of-scope upstream file")
    }
    if expected.contains(file) {
      raise RunnerError("duplicate upstream file: " + file)
    }
    let sha = string(field(entry, "sha256"))
    if sha.length() != 64 {
      raise RunnerError("invalid upstream SHA-256")
    }
    expected[file] = sha
  }
  if !expected.contains("LICENSE") {
    raise RunnerError("upstream license is not inventoried")
  }
  let actual = []
  inventory(base + "/tests/draft2020-12", "tests/draft2020-12", actual)
  actual.push("LICENSE")
  actual.sort()
  for file in actual {
    if !expected.contains(file) {
      errors.push("unexpected upstream file: " + file)
    }
  }
  let files : Map[String, @pjson.Json] = Map([])
  let names = expected.keys().collect()
  names.sort()
  for file in names {
    try {
      let bytes = @fs.read_file(base + "/" + file).binary()
      if digest(bytes) != expected[file] {
        errors.push("SHA-256 mismatch: " + file)
      }
      if file.has_suffix(".json") {
        files[file] = parse_json(@utf8.decode(bytes))
      }
    } catch {
      error =>
        errors.push(
          "cannot read upstream file " + file + ": " + error.to_string(),
        )
    }
  }
  files
}

///|
fn markdown_cell(text : String) -> String {
  text
  .replace(old="|", new="\\|")
  .replace(old="\n", new=" ")
  .replace(old="\r", new=" ")
}

///|
fn markdown(report : SuiteReport) -> String {
  let out = StringBuilder()
  out.write_string(
    "# JSON Schema compatibility report\n\nGenerated by the native schema-suite runner; rejection and skipping are not validation passes.\n\n",
  )
  out.write_string(
    "Upstream: [JSON-Schema-Test-Suite](https://github.com/json-schema-org/JSON-Schema-Test-Suite/tree/" +
    report.upstream_commit +
    ") at `" +
    report.upstream_commit +
    "`.\n\n",
  )
  out.write_string(
    "Manifest SHA-256: `" +
    report.manifest_sha256 +
    "`.\n\nToolchain:\n\n```text\n" +
    report.toolchain +
    "\n```\n\nCommand from repository root (Git Bash or Linux):\n\n```sh\n" +
    report.command +
    "\n```\n\n",
  )
  let c = report.counts
  out.write_string(
    "Groups: " +
    c.groups.to_string() +
    "; tests: " +
    c.tests.to_string() +
    "; executed: " +
    c.executed.to_string() +
    "; passed: " +
    c.passed.to_string() +
    "; compile rejected: " +
    c.compile_rejected.to_string() +
    "; skipped: " +
    c.skipped.to_string() +
    ".\n\n",
  )
  out.write_string(
    "False accepts: " +
    c.false_accept.to_string() +
    "; false rejects: " +
    c.false_reject.to_string() +
    "; execution errors: " +
    c.execution_error.to_string() +
    "; scope errors: " +
    report.scope_errors.length().to_string() +
    "; runner errors: " +
    report.runner_errors.length().to_string() +
    ".\n\n",
  )
  out.write_string(
    "| Capability | Groups | Tests | Executed | Passed | False accept | False reject | Compile rejected | Execution error | Skipped |\n|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|\n",
  )
  for item in report.capabilities {
    let n = item.counts
    out.write_string(
      "| " +
      markdown_cell(item.capability) +
      " | " +
      [
        n.groups,
        n.tests,
        n.executed,
        n.passed,
        n.false_accept,
        n.false_reject,
        n.compile_rejected,
        n.execution_error,
        n.skipped,
      ]
      .map(fn(x) { x.to_string() })
      .join(" | ") +
      " |\n",
    )
  }
  out.write_string(
    "\n## Scope and limitations\n\nThis is an explicit Draft 2020-12 subset, not full conformance. Supported assertions include types, exact decimal bounds/multipleOf/equality, string and collection counts, uniqueness, tuple items, contains/minContains/maxContains matching counts, property schemas/patterns, const/enum, if/then/else conditional branches, applicators, and local JSON Pointer references with $defs. The manifest independently declares every vendored group. All groups are matched by file, index and exact description.\n\nformat is annotation only. External references, named anchors, $id, dynamic references, vocabularies, dependentRequired, dependentSchemas, propertyNames, unevaluatedItems, unevaluatedProperties and other undeclared assertions remain unsupported. Regex supports literals, dot, classes, ordinary groups, alternation, repetitions and anchors; unsupported mechanisms are rejected. Dot excludes four line terminators; whitespace uses the ECMAScript set. Count parameters are limited to 1000000000. Schema snapshots permit depth 128 and 100000 JSON nodes; evaluation permits 128 active schema calls and 100000 visits per record. Same-instance reference cycles and exhaustion are execution errors.\n\nEvery exclusion below identifies its group; per-test_index results and diagnostics are in the JSON report. Expected rejections count only as scope-policy compliance.\n\n## Exclusions\n\n| File | Group | Description | Policy | Reason | Tests |\n|---|---:|---|---|---|---:|\n",
  )
  let excluded : Map[(String, Int), Array[Record]] = Map([])
  for record in report.records {
    if record.action != "validate" {
      let key = (record.file, record.group)
      match excluded.get(key) {
        Some(rows) => rows.push(record)
        None => excluded[key] = [record]
      }
    }
  }
  let keys = excluded.keys().collect()
  keys.sort()
  for key in keys {
    let rows = excluded[key]
    let record = rows[0]
    out.write_string(
      "| " +
      markdown_cell(record.file) +
      " | " +
      record.group.to_string() +
      " | " +
      markdown_cell(record.group_description) +
      " | " +
      record.action +
      " | " +
      markdown_cell(record.reason) +
      " | " +
      rows.length().to_string() +
      " |\n",
    )
  }
  out.write_string("\n## Errors and discrepancies\n\n")
  for error in report.runner_errors + report.scope_errors {
    out.write_string("- " + markdown_cell(error) + "\n")
  }
  for record in report.records {
    if record.result == "false_accept" ||
      record.result == "false_reject" ||
      record.result == "execution_error" ||
      (record.action == "validate" && record.result == "compile_rejected") {
      out.write_string(
        "- " +
        record.file +
        " group " +
        record.group.to_string() +
        " test_index " +
        record.test_index.to_string() +
        " (" +
        markdown_cell(record.description) +
        "): " +
        record.result +
        "; " +
        markdown_cell(record.diagnostics.join("; ")) +
        "\n",
      )
    }
  }
  if report_code(report) == 0 {
    out.write_string(
      "All declared validation cases agree; expected rejections match policy; inventory and manifest are complete.\n",
    )
  } else {
    out.write_string(
      "Acceptance failed; the errors above must be resolved before claiming compatibility.\n",
    )
  }
  out.to_string()
}

///|
fn parent_directory(path : String) -> String {
  let parts = path.split("/").map(fn(s) { s.to_owned() }).collect()
  if parts.length() <= 1 {
    "."
  } else {
    parts[:parts.length() - 1].to_owned().join("/")
  }
}

///|
async fn run_suite(args : Array[String]) -> Int {
  let mut manifest = "testdata/schema-suite-manifest.json"
  let mut report_json = "_build/schema-suite/report.json"
  let mut report_md = "docs/schema-compatibility.md"
  let mut strict = false
  let mut i = 0
  while i < args.length() {
    let option = args[i]
    if option == "--strict" {
      strict = true
      i = i + 1
      continue
    }
    if i + 1 >= args.length() {
      raise RunnerError("missing argument for " + option)
    }
    match option {
      "--manifest" => manifest = args[i + 1]
      "--report-json" => report_json = args[i + 1]
      "--report-md" => report_md = args[i + 1]
      _ => raise RunnerError("unknown argument: " + option)
    }
    i = i + 2
  }
  let runner_errors = []
  let scope_errors = []
  let records = []
  let mut manifest_sha256 = "unavailable"
  try {
    let (manifest_value, sha) = read_json(manifest)
    manifest_sha256 = sha
    let entries = policies(manifest_value)
    let files = load_suite(runner_errors)
    let completeness_errors = check_scope(files, entries)
    runner_errors.append(completeness_errors)
    if completeness_errors.is_empty() {
      for policy in entries {
        records.append(
          run_group(
            array(files[policy.file])[policy.group],
            policy,
            scope_errors,
          ),
        ) catch {
          error =>
            runner_errors.push(
              policy.file +
              " group " +
              policy.group.to_string() +
              ": " +
              error.to_string(),
            )
        }
      }
    }
  } catch {
    error => runner_errors.push(error.to_string())
  }
  records.sort_by(fn(a, b) {
    (a.file, a.group, a.test_index).compare((b.file, b.group, b.test_index))
  })
  let names : Map[String, Bool] = Map([])
  for record in records {
    names[record.capability] = true
  }
  let sorted_names = names.keys().collect()
  sorted_names.sort()
  let capabilities = sorted_names.map(fn(name) {
    {
      capability: name,
      counts: count_records(
        records.filter(fn(record) { record.capability == name }),
      ),
    }
  })
  let toolchain = try {
    let (code, out, _) = @process.collect_output("moon", ["version", "--all"])
    if code != 0 {
      raise RunnerError("moon version failed")
    }
    // Strip host-specific executable locations; exact version lines are stable.
    out
    .text()
    .split("\n")
    .map(fn(line) {
      line.to_owned().split(" ~").next().unwrap_or("").to_owned()
    })
    .collect()
    .join("\n")
    .trim()
    .to_owned()
  } catch {
    error => {
      runner_errors.push("cannot record toolchain: " + error.to_string())
      "unavailable"
    }
  }
  let command = "moon run --target native cmd/schema_suite -- --manifest " +
    manifest +
    " --report-json " +
    report_json +
    " --report-md " +
    report_md +
    (if strict { " --strict" } else { "" })
  scope_errors.sort()
  runner_errors.sort()
  let report : SuiteReport = {
    upstream_commit: upstream_sha,
    manifest_sha256,
    toolchain,
    command,
    counts: count_records(records),
    capabilities,
    scope_errors,
    runner_errors,
    records,
  }
  let code = report_code(report)
  try {
    if !@fs.exists(parent_directory(report_json)) {
      @fs.mkdir(parent_directory(report_json), recursive=true)
    }
    if !@fs.exists(parent_directory(report_md)) {
      @fs.mkdir(parent_directory(report_md), recursive=true)
    }
    @fs.write_file(
      report_json,
      @json.to_json(report).stringify(indent=2) + "\n",
    )
    @fs.write_file(report_md, markdown(report))
  } catch {
    error => {
      @stdio.stderr.write("report write failed: " + error.to_string() + "\n")
      return 2
    }
  }
  @stdio.stdout.write(
    "schema-suite: " +
    report.counts.tests.to_string() +
    " tests; " +
    report.counts.passed.to_string() +
    " passed; " +
    report.counts.compile_rejected.to_string() +
    " compile_rejected; " +
    report.counts.skipped.to_string() +
    " skipped; exit " +
    code.to_string() +
    "\n",
  )
  // No mode can convert a failed acceptance into process success.
  code
}

///|
async fn main {
  let args = @env.args()
  let code = run_suite(args[1:].to_owned()) catch {
    error => {
      @stdio.stderr.write(
        "schema-suite runner error: " + error.to_string() + "\n",
      )
      2
    }
  }
  @sys.exit(code)
}
