# Release artifacts of the frontend dashboard, regenerated by `warren build`.
frontend/dist/
node_modules/

# Statistics files written by `--json-out`. Both are generated from test.json
# rather than edited by hand, so neither belongs in the repository:
#   - the usage examples in the README write one to the repository root
#   - the dashboard reads the one under frontend/public
# Regenerate the dashboard's copy with the command in the README's dashboard
# section before opening the page.
/stats.json
frontend/public/stats.json

# The documents `bench/run.sh` measures. `bench/generate.sh` writes them and is
# what the repository keeps: the documents are output rather than source, and
# the largest of them is ten megabytes.
bench/*.json
